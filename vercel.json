{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "python",
      "entrypoint": "api/index.py",
      "functions": {
        "api/index.py": {
          "excludeFiles": "{frontend/**,tests/**,__tests__/**,**/*.test.py,**/test_*.py,output/**,.git/**,.venv/**,venv/**}"
        }
      }
    },
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "app",
          "format": "url",
          "env": "AGENT_SERVICE_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
