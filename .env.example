# ==========================================
# Pulse Platform - Environment Variables Template
# Copy this file to .env or .env.local and fill in the values.
# NEVER commit your actual .env file to Git!
# ==========================================

# -----------------------------
# Supabase Configuration
# -----------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------
# LLM Providers (OpenAI, Gemini, or Claude)
# -----------------------------
OPENAI_API_KEY=your-openai-api-key
# GEMINI_API_KEY=your-google-gemini-api-key
# ANTHROPIC_API_KEY=your-claude-api-key

# -----------------------------
# LangChain & LangSmith Tracing (Optional)
# -----------------------------
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-api-key
# LANGCHAIN_PROJECT=pulse-reddit-agent
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# -----------------------------
# Reddit Data Extraction
# -----------------------------
# NOTE: No Reddit Client ID or Client Secret required!
# Queries Reddit's public endpoint directly.
REDDIT_USER_AGENT=NewsMonitorAgent/1.0 (internal local tool)

# -----------------------------
# News & Market Data APIs
# -----------------------------
FINNHUB_API_KEY=your-finnhub-api-key
NEWS_API_KEY=your-newsapi-key
# ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key
