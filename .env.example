# ==========================================
# Pulse Platform - Environment Variables Template
# Copy this file to .env or .env.local and fill in the values.
# NEVER commit your actual .env file to Git!
# ==========================================

# -----------------------------
# Supabase Configuration
# -----------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------
# LLM Providers (Sentiment, Themes, Summaries)
# -----------------------------
GEMINI_API_KEY=your-google-gemini-api-key
# ANTHROPIC_API_KEY=your-claude-api-key
# OPENAI_API_KEY=your-openai-api-key

# -----------------------------
# LangChain / LangSmith Tracing (Optional)
# -----------------------------
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langchain-api-key
# LANGCHAIN_PROJECT=pulse-reddit-agent
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# -----------------------------
# News & Market Data APIs
# -----------------------------
FINNHUB_API_KEY=your-finnhub-api-key
NEWS_API_KEY=your-newsapi-key
# ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key

# -----------------------------
# Social Data APIs (Official APIs only)
# -----------------------------
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=PulsePlatform/1.0.0 (by u/yourusername)
# BLUESKY_HANDLE=
# BLUESKY_APP_PASSWORD=
# STOCKTWITS_API_KEY=
